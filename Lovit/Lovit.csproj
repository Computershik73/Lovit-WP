  <!--
    Своя криптография. Библиотека собрана только под ARM (native\build.cmd):
    под эмулятор нет готового OpenSSL, и там приложение обходится системным
    TLS. Link кладёт её в корень пакета — оттуда её и находит DllImport.

    VCLibs 12.0 — среда выполнения Visual C++ 2013, на которой живёт
    LovitTls.dll. Без этой ссылки пакет установится, а библиотека при первом
    вызове не загрузится.
  -->
  <ItemGroup Condition="'$(Platform)' == 'ARM'">
    <Content Include="Native\arm\LovitWebP.dll">
      <Link>LovitWebP.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\arm\LovitTls.dll">
      <Link>LovitTls.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\arm\LovitOpus.dll">
      <Link>LovitOpus.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\arm\LovitLottie.dll">
      <Link>LovitLottie.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <SDKReference Include="Microsoft.VCLibs, version=12.0" />
  </ItemGroup>
  <!--
    Под эмулятор своего OpenSSL нет, а разбор картинок собирается и для него:
