    <PackageCertificateKeyFile>Lovit_TemporaryKey.pfx</PackageCertificateKeyFile>
    <!--
      Подпись прямо при сборке, а не только через «создать пакеты».
      Раньше .appx выходил без AppxSignature.p7x, а неподписанный пакет не
      ставится ничем.

      Отпечаток обязателен: без него подпись молча не делается — ни ошибки,
      ни подписи. Он должен совпадать с сертификатом в Lovit_TemporaryKey.pfx.

      EnableSigningChecks выключен намеренно. Своя проверка Visual Studio
      отвергает этот сертификат с APPX0107 «непригоден для подписывания»,
      хотя он вполне исправен: не просрочен, с закрытым ключом, с нужным
      назначением и с Subject, совпадающим с Publisher манифеста. Проверить
      это просто — signtool подписывает им пакет молча и без единой жалобы,
      и подпись выходит настоящая. Придирается именно предварительная
      проверка, рассчитанная на сертификат для магазина, а не на
      самоподписанный для своей установки; сама подпись после её отключения
      делается тем же signtool.
    -->
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>3F1A38B70DAD5D8C470BA5F97ACD169F165CDCBC</PackageCertificateThumbprint>
    <EnableSigningChecks>false</EnableSigningChecks>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxBundlePlatforms>arm</AppxBundlePlatforms>
  </PropertyGroup>
