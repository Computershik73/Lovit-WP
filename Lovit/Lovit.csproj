  <!--
    Номер сборки — четвёртое число в Version манифеста.

    Телефон отказывается ставить пакет с той же версией, но другим
    содержимым: «Increment the version number of the package to be
    installed». Своего поля вроде versionCode у appx нет, зато версия
    четырёхчастная, а показываем мы пользователю только три первых
    (см. AboutPage) — значит четвёртое и есть тот самый номер сборки,
    невидимый снаружи.

    AppxAutoIncrementPackageRevision тут не годится: его понимает мастер
    «создать пакеты» в Visual Studio, а из командной строки он не делает
    ничего — проверено. Поэтому поднимаем сами, перед сборкой манифеста.
  -->
  <Target Name="BumpPackageRevision" BeforeTargets="_ValidatePresenceOfAppxManifestItems">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest"
             Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" ItemName="_PackageVersion" />
    </XmlPeek>

    <PropertyGroup>
      <_Version>@(_PackageVersion)</_Version>
      <_NextRevision>$([MSBuild]::Add($([System.Version]::Parse($(_Version)).Revision), 1))</_NextRevision>
      <_NextVersion>$([System.Version]::Parse($(_Version)).Major).$([System.Version]::Parse($(_Version)).Minor).$([System.Version]::Parse($(_Version)).Build).$(_NextRevision)</_NextVersion>
    </PropertyGroup>

    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest"
             Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version"
             Value="$(_NextVersion)" />

    <Message Importance="high" Text="Версия пакета: $(_Version) -> $(_NextVersion)" />
  </Target>
