<Page
    x:Class="Lovit.Pages.IncomingCallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF15181D">

    <!--
        Экран входящего звонка. Свой тёмный фон при любой теме: звонок
        должен выглядеть звонком, а не ещё одной страницей настроек.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="24,0">
            <Grid Width="160" Height="160" HorizontalAlignment="Center">
                <Ellipse Fill="#FF2B3440" />
                <TextBlock x:Name="Initials"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="56"
                           Foreground="White" />
                <Ellipse x:Name="Avatar" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <TextBlock x:Name="CallerName"
                       Margin="0,24,0,0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="32"
                       Foreground="White" />

            <TextBlock x:Name="Kind"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       Foreground="#FFA9B4C2" />
        </StackPanel>

        <!--
            Честно, что ответить отсюда нельзя: иначе человек будет искать
            кнопку «ответить», которой нет.
        -->
        <TextBlock Grid.Row="1"
                   Margin="24,0,24,24"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="15"
                   Foreground="#FFA9B4C2"
                   Text="Отвечать на звонки Ловит пока не умеет. Ответьте с другого устройства или отклоните." />

        <Grid Grid.Row="2" Margin="24,0,24,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="HideButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Content="скрыть"
                    Foreground="White"
                    BorderBrush="#FF55606E"
                    Click="OnHide" />

            <Button x:Name="DeclineButton"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Content="отклонить"
                    Foreground="White"
                    Background="#FFD9362B"
                    BorderBrush="#FFD9362B"
                    Click="OnDecline" />
        </Grid>
    </Grid>
</Page>
