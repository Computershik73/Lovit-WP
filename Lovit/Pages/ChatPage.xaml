<Page
    x:Class="Lovit.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:Lovit.Ui"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!--
            Кнопка без своего вида — прозрачная рамка вокруг чужой разметки.

            Нужна из-за того, как список раздаёт нажатия: пункт списка
            замечает касание раньше, чем оно доходит до вложенных частей, и
            пометить его обработанным уже поздно. Оттого нажатие по подписи
            «Переслано от …» делало сразу два дела — открывало источник и
            вдобавок фотографию того же сообщения, которая ложилась в
            историю переходов; «назад» после этого показывало её.

            Кнопка же разбирает касание сама и списку его не отдаёт. Вид у
            неё снят до голого содержимого: ни рамки, ни полей, ни подсветки
            — на пузыре им взяться неоткуда.
        -->
        <Style x:Key="Bare" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!--
        Имя нужно коду: когда вылезает клавиатура, страница ужимается на её
        высоту снизу. Без этого система вместо сжатия уводит всю страницу
        вверх целиком, вместе с шапкой.
    -->
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: плитка собеседника, название и вторая строка. -->
        <Grid x:Name="Header"
              Grid.Row="0"
              Margin="19,14,19,8"
              Tapped="OnHeaderTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="AvatarBox" Grid.Column="0" Width="56" Height="56" Margin="0,0,12,0">
                <Border x:Name="InitialsBox">
                    <TextBlock x:Name="InitialsText"
                               Text=""
                               Foreground="White"
                               FontSize="24"
                               FontFamily="{ThemeResource PhoneFontFamilySemiLight}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Image x:Name="AvatarImage" Stretch="UniformToFill" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text=""
                           FontSize="28"
                           FontFamily="{ThemeResource PhoneFontFamilySemiLight}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="SubtitleText"
                           Text=""
                           FontSize="15"
                           Opacity="0.6"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Закреплённое сообщение: нажатие ведёт к нему в истории. -->
        <Border x:Name="PinnedBar"
                Grid.Row="1"
                Background="{ThemeResource PhoneChromeBrush}"
                Padding="19,8,19,8"
                Visibility="Collapsed"
                Tapped="OnPinnedTapped">
            <StackPanel>
                <TextBlock Text="Закреплённое сообщение" FontSize="13" Opacity="0.6" />
                <TextBlock x:Name="PinnedText"
                           Text=""
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="WordEllipsis" />
            </StackPanel>
        </Border>

        <ListView x:Name="MessagesList"
                  Grid.Row="2"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnMessageClick"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,2,12,2" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <!--
                        Удержание — для пальца, правая кнопка — для мыши.
                        Событие удержания мышь не подаёт вовсе: в этой
                        разметке оно бывает только от касания и пера, и на
                        настольной Windows меню сообщения не открывалось
                        ничем.
                    -->
                    <StackPanel Holding="OnMessageHolding"
                                RightTapped="OnMessageRightTapped">
                        <TextBlock Text="{Binding DayLabel}"
                                   Visibility="{Binding DayVisibility}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.55"
                                   FontSize="14"
                                   Margin="0,10,0,10" />

                        <!--
                            Служебное — «вошёл», «вышел», «закрепил», звонок —
                            строкой посередине, без пузыря: это не чья-то
                            реплика, и рисовать её как реплику неверно.
                        -->
                        <TextBlock Text="{Binding Text}"
                                   Visibility="{Binding ServiceVisibility}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.55"
                                   FontSize="14"
                                   Margin="24,6,24,6" />

                        <Border Background="{Binding Bubble}"
                                Visibility="{Binding BubbleVisibility}"
                                HorizontalAlignment="{Binding Side}"
                                MaxWidth="380"
                                Padding="12,8,12,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Author}"
                                           Visibility="{Binding AuthorVisibility}"
                                           Foreground="{Binding TextBrush}"
                                           FontSize="14"
                                           Opacity="0.75"
                                           Margin="0,0,0,2" />

                                <!--
                                    Пересылка и ответ: обе подписи над текстом.

                                    Переход к источнику висит на самой подписи,
                                    а не на всём пузыре: нажатие по тексту
                                    пересланного поста уводило в чужую
                                    переписку, хотя его просто читали.
                                -->
                                <Button Style="{StaticResource Bare}"
                                        Visibility="{Binding QuoteVisibility}"
                                        Margin="0,0,0,4"
                                        Click="OnQuoteClick">
                                <Border BorderBrush="{Binding TextBrush}"
                                        BorderThickness="2,0,0,0"
                                        Background="Transparent"
                                        Opacity="0.8"
                                        Padding="6,0,0,0"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="{Binding QuoteTitle}"
                                                   Foreground="{Binding TextBrush}"
                                                   FontSize="13" />
                                        <!-- Цитата в две строки, обрезка на второй. -->
                                        <TextBlock Text="{Binding QuoteText}"
                                                   Foreground="{Binding TextBrush}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="WordEllipsis" />
                                    </StackPanel>
                                </Border>
                                </Button>

                                <!--
                                    Несколько снимков одним сообщением —
                                    сеткой. Ряды и размеры ячеек посчитаны
                                    заранее, здесь их только раскладывают:
                                    внешний список даёт ряды, внутренний —
                                    ячейки ряда.
                                -->
                                <ItemsControl ItemsSource="{Binding Album}"
                                              Visibility="{Binding AlbumVisibility}"
                                              HorizontalAlignment="{Binding Side}"
                                              Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Bare}"
                                                                Margin="{Binding Gap}"
                                                                Click="OnAlbumClick">
                                                        <Grid Width="{Binding Wide}"
                                                              Height="{Binding Tall}"
                                                              Background="#22000000">
                                                            <!--
                                                                Снимок обрезается
                                                                своей рамкой: у
                                                                ячейки размер
                                                                задан, а
                                                                UniformToFill
                                                                заполняет её
                                                                целиком.
                                                            -->
                                                            <Image Source="{Binding Photo}"
                                                                   Width="{Binding Wide}"
                                                                   Height="{Binding Tall}"
                                                                   Stretch="UniformToFill" />

                                                            <!-- Сколько снимков не поместилось. -->
                                                            <Border Visibility="{Binding MoreVisibility}"
                                                                    Background="#99000000">
                                                                <TextBlock Text="{Binding More}"
                                                                           Foreground="White"
                                                                           FontSize="28"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--
                                    Картинка внутри пузыря: CDN мессенджера
                                    отдаёт WebP, и до своего разбора здесь
                                    была только подпись «Фото».
                                -->
                                <!--
                                    Место под картинку отводится сразу, по
                                    присланным размерам: иначе пузырь вырастал
                                    в тот миг, когда фотография догружалась, и
                                    список дёргался под пальцем.
                                -->
                                <Border x:Name="PhotoFrame"
                                        Visibility="{Binding PhotoVisibility}"
                                        Height="{Binding PhotoHeight}"
                                        Width="{Binding PhotoWidth}"
                                        HorizontalAlignment="{Binding Side}"
                                        Background="{Binding PhotoBackdrop}"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Image Source="{Binding Photo}" Stretch="Uniform" />

                                        <!--
                                            Кружок обрезается в круг: всё
                                            вокруг него закрашивается цветом
                                            страницы поверх кадра. Обрезка в
                                            этой разметке умеет только
                                            прямоугольник, поэтому наоборот.
                                        -->
                                        <Path Data="{Binding NoteMask}"
                                              Visibility="{Binding NoteVisibility}"
                                              Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

                                        <!--
                                            У ролика управление лежит поверх
                                            кадра: круглая кнопка посередине и
                                            длительность в углу. Подписи
                                            «Видео» тут нет — и без неё видно,
                                            что это.
                                        -->
                                        <Grid Visibility="{Binding OverlayVisibility}">
                                            <Border Background="#77000000"
                                                    Width="60"
                                                    Height="60"
                                                    CornerRadius="30"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MediaGlyph}"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="26"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <Border Background="#99000000"
                                                    HorizontalAlignment="{Binding MediaStatusSide}"
                                                    VerticalAlignment="Bottom"
                                                    Margin="6"
                                                    Padding="7,2,7,3">
                                                <TextBlock Text="{Binding MediaStatus}"
                                                           FontSize="12"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!--
                                    Голосовое, музыка, видео — плашка с
                                    кнопкой и полосой. Проигрыватель на всю
                                    страницу один (см. ниже): по одному на
                                    каждое сообщение телефон бы не вынес.
                                -->
                                <Border Visibility="{Binding MediaVisibility}"
                                        Background="#28000000"
                                        Padding="10,8,10,8"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="{Binding MediaGlyph}"
                                                Click="OnPlayTapped"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="20"
                                                MinWidth="0"
                                                Padding="10,2,10,2"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MediaTitle}"
                                                       Foreground="{Binding TextBrush}"
                                                       FontSize="16"
                                                       TextTrimming="WordEllipsis" />

                                            <ProgressBar Value="{Binding MediaPercent}"
                                                         Visibility="{Binding MediaBarVisibility}"
                                                         Maximum="100"
                                                         Height="4"
                                                         Margin="0,4,0,2" />

                                            <!--
                                                График громкости: одна фигура,
                                                растянутая под ширину плашки.
                                            -->
                                            <!--
                                                По графику перематывают —
                                                нажатием и протягиванием.
                                                Заливка обязательна: без неё
                                                нажатие между столбиками
                                                проваливается насквозь.
                                            -->
                                            <Grid Visibility="{Binding WaveVisibility}"
                                                  Height="26"
                                                  Margin="0,4,0,2"
                                                  Background="Transparent"
                                                  ManipulationMode="TranslateX"
                                                  Tapped="OnWaveTapped"
                                                  ManipulationDelta="OnWaveDragged">
                                                <!--
                                                    Две фигуры одна поверх
                                                    другой: тусклая целиком и
                                                    яркая по уже прозвучавшему.
                                                    Обе одной ширины, поэтому
                                                    при растягивании столбики
                                                    совпадают.
                                                -->
                                                <Path Data="{Binding WaveShape}"
                                                      Fill="{Binding TextBrush}"
                                                      Stretch="Fill"
                                                      Opacity="0.35" />

                                                <Path Data="{Binding WavePlayed}"
                                                      Fill="{Binding TextBrush}"
                                                      Stretch="Fill" />
                                            </Grid>

                                            <TextBlock Text="{Binding MediaStatus}"
                                                       Foreground="{Binding TextBrush}"
                                                       FontSize="12"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--
                                    Присланный файл — плашкой со значком, а
                                    не строчкой текста: так его видно среди
                                    реплик и понятно, что по нему нажимают.
                                -->
                                <Border Visibility="{Binding FileVisibility}"
                                        Background="#28000000"
                                        Padding="10,8,10,8"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE160;"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="26"
                                                   Foreground="{Binding TextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="{Binding TextBrush}"
                                                       FontSize="16"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="WordEllipsis" />
                                            <TextBlock Text="{Binding FileSize}"
                                                       Foreground="{Binding TextBrush}"
                                                       FontSize="12"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--
                                    Текст собирается кусками, а не привязкой:
                                    ссылки и начертания живут в наборе Inline,
                                    к строке их не привязать.
                                -->
                                <TextBlock ui:RichTextBlock.Source="{Binding Formatted}"
                                           Visibility="{Binding TextVisibility}"
                                           Foreground="{Binding TextBrush}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="False"
                                           FontSize="20" />

                                <TextBlock Text="{Binding Reactions}"
                                           Visibility="{Binding ReactionsVisibility}"
                                           Foreground="{Binding TextBrush}"
                                           FontSize="14"
                                           Margin="0,4,0,0" />

                                <!--
                                    Время и галочки своего сообщения. Галочки
                                    шрифтом символов: в Segoe WP знака нет, а
                                    вторая наезжает на первую сжатым
                                    межбуквенным расстоянием, как у MAX.
                                -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Time}"
                                               Foreground="{Binding TextBrush}"
                                               FontSize="13"
                                               Opacity="0.6" />
                                    <TextBlock Text="{Binding Ticks}"
                                               Visibility="{Binding TicksVisibility}"
                                               Opacity="{Binding TicksOpacity}"
                                               Foreground="{Binding TextBrush}"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="13"
                                               CharacterSpacing="-400"
                                               Margin="5,0,0,0" />
                                </StackPanel>

                                <!--
                                    Кнопки бота. Приходят рядами, поэтому два
                                    вложенных списка: внешний — строки, внутри
                                    каждой кнопки идут слева направо.
                                -->
                                <ItemsControl ItemsSource="{Binding Buttons}"
                                              Visibility="{Binding ButtonsVisibility}"
                                              Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Text}"
                                                                Click="OnInlineButton"
                                                                FontSize="16"
                                                                Padding="10,4,10,4"
                                                                MinWidth="0"
                                                                Margin="0,0,4,4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            Кнопка «вниз» со счётчиком: сколько сообщений пришло, пока
            читали выше по переписке.

            Стоит углом над списком, а не отдельной строкой разметки: место
            она занимать не должна — переписка под ней видна целиком.

            Стрелка нарисована, а не взята значком: набор значков телефона
            на разных сборках системы разный, и промахнуться мимо нужного
            куда легче, чем провести две линии.
        -->
        <Grid x:Name="JumpDown"
              Grid.Row="2"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,16,12"
              Visibility="Collapsed"
              Tapped="OnJumpDown">

            <Border Width="48"
                    Height="48"
                    CornerRadius="24"
                    Margin="0,10,0,0"
                    Background="{ThemeResource PhoneChromeBrush}">
                <Path Data="M 0,0 L 9,9 L 18,0"
                      Stroke="{ThemeResource PhoneForegroundBrush}"
                      StrokeThickness="2.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,3" />
            </Border>

            <Border x:Name="JumpBadge"
                    Background="{ThemeResource PhoneAccentBrush}"
                    CornerRadius="10"
                    MinWidth="20"
                    Height="20"
                    Padding="6,0,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <TextBlock x:Name="JumpCount"
                           Text=""
                           Foreground="White"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Полоска над строкой ввода: на что отвечаем или что правим. -->
        <Grid x:Name="ReplyBar"
              Grid.Row="3"
              Background="{ThemeResource PhoneChromeBrush}"
              Margin="12,0,12,4"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="ReplyKind" Text="Ответ на" FontSize="13" Opacity="0.6" />
                <TextBlock x:Name="ReplyText"
                           Text=""
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="WordEllipsis" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="&#xE10A;"
                    FontFamily="Segoe UI Symbol"
                    MinWidth="48"
                    Padding="0"
                    Click="OnCancelReply" />
        </Grid>

        <Grid Grid.Row="4" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     PlaceholderText="Сообщение"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     TextChanged="OnInputChanged"
                     KeyUp="OnInputKeyUp" />

            <!--
                Скрепка: фотография или файл. Что именно — спрашивается
                нажатием, отдельных кнопок на две вещи в строке ввода нет
                места.
            -->
            <Button x:Name="AttachButton"
                    Grid.Column="1"
                    Content="&#xE16C;"
                    FontFamily="Segoe UI Symbol"
                    Margin="6,0,0,0"
                    MinWidth="60"
                    SizeChanged="OnAttachSized"
                    Click="OnAttach" />

            <Button x:Name="SendButton"
                    Grid.Column="2"
                    Content="&#xE122;"
                    FontFamily="Segoe UI Symbol"
                    Margin="6,0,0,0"
                    MinWidth="60"
                    Visibility="Collapsed"
                    Click="OnSend" />

            <!--
                Запись голосового и кружка. Не кнопкой: кнопка забирает себе
                нажатие целиком, а здесь важно всё движение пальца — удержание
                начинает запись, влево отменяет, вверх освобождает палец.
                Короткое же касание переключает, что именно записывать, и
                значок меняется на нём же.

                Стоит она там же, где отправка, и подменяет её: пока не
                набрано ни слова, отправлять нечего, а как набрано — запись
                уже не нужна. Размер берётся от соседней кнопки: сама по себе
                рамка растянулась бы во всю высоту строки ввода.
            -->
            <Border x:Name="RecordButton"
                    Grid.Column="2"
                    Background="{ThemeResource PhoneAccentBrush}"
                    Margin="6,0,0,0"
                    MinWidth="60"
                    VerticalAlignment="Center"
                    IsHoldingEnabled="False"
                    PointerPressed="OnRecordDown"
                    PointerMoved="OnRecordMoved"
                    PointerReleased="OnRecordUp"
                    PointerCanceled="OnRecordLost"
                    PointerCaptureLost="OnRecordLost">
                <TextBlock x:Name="RecordGlyph"
                           Text="&#xE1D6;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="20"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- В канале писать нельзя: вместо строки ввода — подписка. -->
            <Button x:Name="SubscribeButton"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Content="подписаться"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed"
                    Click="OnSubscribe" />
        </Grid>

        <!--
            Строка записи голосового. Занимает то же место, что и ввод, и
            накрывает его: во время записи писать всё равно нельзя, а два
            ряда подряд на этом экране не помещаются.
        -->
        <Grid x:Name="RecordBar"
              Grid.Row="4"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Margin="12,0,12,12"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Точка мигает: без неё непонятно, идёт ли запись вообще. -->
            <Ellipse x:Name="RecordDot"
                     Grid.Column="0"
                     Width="12"
                     Height="12"
                     Fill="#E04040"
                     VerticalAlignment="Center"
                     Margin="4,0,10,0" />

            <TextBlock x:Name="RecordTime"
                       Grid.Column="1"
                       Text="0:00"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

            <!--
                Живой график громкости. Он же и подсказка: если запись идёт, а
                график лежит ровно — микрофон не слышит.
            -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Path x:Name="RecordWave"
                      Height="28"
                      Fill="{ThemeResource PhoneAccentBrush}"
                      Stretch="Fill"
                      HorizontalAlignment="Stretch" />

                <TextBlock x:Name="RecordHint"
                           Text="&#xE100; влево — отмена"
                           FontFamily="Segoe UI Symbol"
                           FontSize="14"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!--
                Пока палец на кнопке, эти две не нужны: отпустил — отправилось.
                Появляются они, когда запись закреплена движением вверх.
            -->
            <StackPanel x:Name="RecordButtons"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Button Content="&#xE10A;"
                        Click="OnRecordCancel"
                        FontFamily="Segoe UI Symbol"
                        MinWidth="60"
                        Padding="0"
                        Margin="6,0,0,0" />

                <Button Content="&#xE122;"
                        Click="OnRecordSend"
                        FontFamily="Segoe UI Symbol"
                        MinWidth="60"
                        Padding="0"
                        Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="Progress"
                     Grid.Row="2"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="Collapsed" />

        <!-- Сколько уже ушло на сервер: полоса без чисел мало что говорит. -->
        <TextBlock x:Name="ProgressText"
                   Grid.Row="2"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,0"
                   FontSize="13"
                   Opacity="0.7"
                   Visibility="Collapsed" />

        <!--
            Проигрыватель. Один на всю страницу и живёт вне списка: заводить
            его на каждое сообщение нельзя — каждый занимает память и держит
            за собой звуковой поток, а сообщений в чате сотни.

            Для голосового и музыки видеть тут нечего, и слой остаётся
            свёрнутым; для видео он разворачивается на весь экран.
        -->
        <Grid x:Name="PlayerBackdrop"
              Grid.RowSpan="5"
              Background="#E6000000"
              Visibility="Collapsed"
              Tapped="OnPlayerBackdropTapped" />

        <!--
            Сам проигрыватель свёрнутым не делается: свёрнутый он замолкает, а
            голосовое слушают, не глядя на него. Поэтому для звука он остаётся
            в разметке точкой в один пиксель, а под видео разворачивается.
        -->
        <!--
            Обрезка проигрывателя в круг.

            Обрезка в этой разметке знает только прямоугольник — зато
            прямоугольник можно повернуть. В пересечении шестнадцати
            квадратов, повёрнутых через 5,625°, остаётся правильный
            шестидесятичетырёхугольник: его грань отходит от круга на
            десятую долю точки, и глазу он от круга неотличим.

            Это настоящая обрезка, а не закраска: за кругом ничего не
            рисуется, и что бы под ним ни лежало — пузыри, картинки, фон, —
            кружок ляжет поверх кругом. Шесть слоёв, что стояли здесь
            раньше, давали двадцатичетырёхугольник, и его грани были видны;
            от них ушли к закраске углов, а та не умеет лежать поверх
            чужого. Слоёв стало вдвое с лишним больше — и обрезка вернулась.

            Каждый слой поворачивает и содержимое; общий поворот снимается
            обратным на самом проигрывателе. Внешний слой без поворота: он
            режет по границам списка, чтобы кружок не лез на шапку и строку
            ввода. Слои стоят всегда, а вступают в дело только под кружок —
            под обычным видео они пусты и на него не влияют.
        -->
        <Grid x:Name="PlayerBounds" Grid.RowSpan="5">
        <Grid x:Name="PlayerClip0">
            <Grid x:Name="PlayerClip1">
                <Grid x:Name="PlayerClip2">
                    <Grid x:Name="PlayerClip3">
                        <Grid x:Name="PlayerClip4">
                            <Grid x:Name="PlayerClip5">
                                <Grid x:Name="PlayerClip6">
                                    <Grid x:Name="PlayerClip7">
                                        <Grid x:Name="PlayerClip8">
                                            <Grid x:Name="PlayerClip9">
                                                <Grid x:Name="PlayerClip10">
                                                    <Grid x:Name="PlayerClip11">
                                                        <Grid x:Name="PlayerClip12">
                                                            <Grid x:Name="PlayerClip13">
                                                                <Grid x:Name="PlayerClip14">
                                                                    <Grid x:Name="PlayerClip15">
                                                                        <MediaElement x:Name="Player"
                                                                                      Width="1"
                                                                                      Height="1"
                                                                                      Opacity="0"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      AreTransportControlsEnabled="False"
                                                                                      AudioCategory="BackgroundCapableMedia"
                                                                                      Stretch="Uniform"
                                                                                      MediaEnded="OnPlayerEnded"
                                                                                      MediaFailed="OnPlayerFailed" />
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        </Grid>

        <!--
            Полоска вокруг кружка, играющего прямо в переписке.
            Проигрыватель на странице один — заводить его на каждое
            сообщение телефон не вынесет, — поэтому он не живёт внутри
            списка, а становится поверх нужного пузыря: место ему
            назначается из кода и поправляется при прокрутке. В круг его
            режут слои обрезки выше, а здесь лежит только белая дуга
            проигранного.
        -->
        <Grid x:Name="NoteRound"
              Grid.RowSpan="5"
              Width="220"
              Height="220"
              Background="Transparent"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Visibility="Collapsed"
              Tapped="OnNoteRoundTapped">

            <!--
                Сколько уже проиграно — белой дугой по самому краю круга.
                Полосе под кружком места нет, а край свободен и виден целиком.
            -->
            <Path x:Name="NotePlayRing"
                  Stroke="White"
                  StrokeThickness="3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Grid>

        <!--
            Выбор реакции — своим слоем, а не вторым системным меню.

            Показать меню из обработчика другого меню в Windows Phone 8.1
            нельзя: всплывающее меню на экране одно, и такая попытка роняла
            приложение. Свой слой этой беды не знает, а заодно не связан и
            пределом в шесть пунктов — лиц можно ставить сколько нужно.
        -->
        <Grid x:Name="ReactionLayer"
              Grid.RowSpan="5"
              Background="#A0000000"
              Visibility="Collapsed"
              Tapped="OnReactionBackdropTapped">

            <Border Background="{ThemeResource PhoneChromeBrush}"
                    VerticalAlignment="Center"
                    Margin="12"
                    Padding="8"
                    Tapped="OnReactionPanelTapped">
                <StackPanel>
                    <StackPanel x:Name="ReactionFaces"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center" />

                    <Button x:Name="ReactionClear"
                            Content="убрать реакцию"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Visibility="Collapsed"
                            Click="OnReactionClear" />
                </StackPanel>
            </Border>
        </Grid>

        <!--
            Управление видео. Внешний слой прозрачен и ловит нажатия по всему
            экрану — он же и показывает кнопки; сам проигрыватель нажатий не
            разбирает, а полоса под ним закрыта картинкой.
        -->
        <Grid x:Name="PlayerControls"
              Grid.RowSpan="5"
              Background="Transparent"
              Visibility="Collapsed"
              Tapped="OnPlayerTapped">

            <Grid x:Name="PlayerChrome"
                  Visibility="Collapsed"
                  Tapped="OnChromeTapped">

                <Button Content="&#xE10A;"
                        Click="OnPlayerClose"
                        FontFamily="Segoe UI Symbol"
                        FontSize="18"
                        MinWidth="0"
                        Padding="12,4,12,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,16,16,0" />

                <Border VerticalAlignment="Bottom"
                        Background="#B0000000"
                        Padding="16,10,16,14">
                <StackPanel>

                    <Grid>
                        <TextBlock x:Name="PlayerAt"
                                   Text="0:00"
                                   HorizontalAlignment="Left"
                                   FontSize="13"
                                   Foreground="White" />
                        <TextBlock x:Name="PlayerTotal"
                                   Text="0:00"
                                   HorizontalAlignment="Right"
                                   FontSize="13"
                                   Foreground="White" />
                    </Grid>

                    <!--
                        Полоса размечена в тысячных долях, а не в секундах:
                        длительность известна только после открытия, и менять
                        предел на ходу — лишний повод для рывков.
                    -->
                    <Slider x:Name="PlayerSeek"
                            Minimum="0"
                            Maximum="1000"
                            Value="0"
                            ValueChanged="OnSeekChanged"
                            Margin="0,2,0,2" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="&#xE100;  5"
                                Click="OnRewind"
                                FontFamily="Segoe UI Symbol"
                                FontSize="16"
                                MinWidth="0"
                                Padding="14,4,14,4"
                                Margin="0,0,8,0" />

                        <Button x:Name="PlayerToggle"
                                Content="&#xE103;"
                                Click="OnTogglePlay"
                                FontFamily="Segoe UI Symbol"
                                FontSize="18"
                                MinWidth="0"
                                Padding="18,4,18,4" />

                        <Button Content="10  &#xE101;"
                                Click="OnForward"
                                FontFamily="Segoe UI Symbol"
                                FontSize="16"
                                MinWidth="0"
                                Padding="14,4,14,4"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--
            Почему пусто. Раньше не загрузившаяся история выглядела как чат
            без сообщений: обрыв связи и пустая переписка на экране были
            неотличимы.
        -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text=""
                   Opacity="0.6"
                   Margin="24,32,24,0"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed" />

        <!--
            Кружок. Камера показывается круглым окошком поверх переписки: она
            при этом остаётся видна, а сам слой не ловит ни одного касания —
            палец в это время лежит на кнопке записи, и перехватить его
            здесь значило бы оборвать съёмку в тот же миг.
        -->
        <Grid x:Name="NoteLayer"
              Grid.RowSpan="5"
              Background="Transparent"
              IsHitTestVisible="False"
              Visibility="Collapsed">

            <Grid x:Name="NoteWindow"
                  Width="240"
                  Height="240"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <!--
                    Обрезка в круг.

                    Обрезать по кругу эта разметка не умеет: обрезка знает
                    только прямоугольник. Зато прямоугольник можно повернуть —
                    и то, что осталось от нескольких повёрнутых, кругу уже не
                    уступает: шесть квадратов через пятнадцать градусов дают
                    двадцатичетырёхугольник, у которого край отходит от круга
                    на один пиксель.

                    Раньше вместо этого всё вокруг круга закрашивалось цветом
                    страницы — и закраска прятала за собой переписку, отчего
                    окошко выглядело вписанным в чёрный квадрат.

                    Каждая ступень поворачивает и содержимое тоже; общий
                    поворот в семьдесят пять градусов снимается на самом
                    показе, вместе с его собственным.
                -->
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,240,240" />
                </Grid.Clip>

                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,240,240" />
                    </Grid.Clip>
                    <Grid.RenderTransform>
                        <RotateTransform Angle="15" />
                    </Grid.RenderTransform>
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,240,240" />
                        </Grid.Clip>
                        <Grid.RenderTransform>
                            <RotateTransform Angle="15" />
                        </Grid.RenderTransform>
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,240,240" />
                            </Grid.Clip>
                            <Grid.RenderTransform>
                                <RotateTransform Angle="15" />
                            </Grid.RenderTransform>
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,240,240" />
                                </Grid.Clip>
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="15" />
                                </Grid.RenderTransform>
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,240,240" />
                                    </Grid.Clip>
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="15" />
                                    </Grid.RenderTransform>
                                    <CaptureElement x:Name="NotePreview"
                                                    Stretch="Fill"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Сколько осталось от минуты — кольцом по краю. -->
                <Path x:Name="NoteRing"
                      Stroke="#E04040"
                      StrokeThickness="5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Grid>
        </Grid>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <!-- Позвонить — только в диалоге: групповых звонков у нас нет. -->
            <AppBarButton x:Name="CallButton"
                          Icon="Phone"
                          Label="позвонить"
                          Visibility="Collapsed"
                          Click="OnCall" />
            <AppBarButton Icon="Contact" Label="сведения" Click="OnInfo" />
            <AppBarButton Icon="Refresh" Label="обновить" Click="OnReload" />

            <!--
                Разметка накладывается на выделенное в поле ввода. Отдельной
                кнопкой, а не значками вокруг строки: места там нет, а
                выделять текст всё равно приходится пальцем.
            -->
            <AppBarButton x:Name="MarkupButton"
                          Icon="Edit"
                          Label="разметка"
                          Click="OnMarkup" />

            <!--
                Какой камерой снимать кружок. Снимается он удержанием
                кнопки записи, и мгновения на выбор там нет — выбирают
                заранее и надолго, потому и в дополнительном списке.
            -->
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="NoteCameraButton"
                              Label="кружок основной камерой"
                              Click="OnNoteCamera" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
