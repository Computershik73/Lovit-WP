<Page
    x:Class="Lovit.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!--
            Один шаблон на все списки: вкладок столько, сколько у аккаунта
            папок, и заводить каждой свой шаблон значило бы копировать
            разметку по десять раз.
        -->
        <!--
            Строка растягивается на всю ширину списка, а не ужимается по
            своему тексту.

            Без этого ListViewItem отдаёт строке ровно столько, сколько она
            попросила, — а просит она по длине превью. Правый столбец со
            временем и счётчиком уезжает вместе с этим краем, и в списке он
            получается рваным: у чата с коротким сообщением время стоит
            заметно левее, чем у соседнего с длинным. Списки поиска и
            переписки растянуты так же, они собраны разметкой; здесь строки
            заводятся кодом, и стиль пришлось назвать.
        -->
        <Style x:Key="ChatRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!--
            Строка списка в духе телефона тех лет: квадратная плитка слева,
            два ряда текста и время справа. Квадрат, а не круг, — на Windows
            Phone круглых аватарок не было нигде, и круг сразу выдаёт чужака.
        -->
        <DataTemplate x:Key="ChatRowTemplate">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="72" Height="72" Margin="0,0,14,0">
                    <Border Background="{Binding AvatarBrush}"
                            Visibility="{Binding InitialsVisibility}">
                        <TextBlock Text="{Binding Initials}"
                                   Foreground="White"
                                   FontSize="30"
                                   FontFamily="{ThemeResource PhoneFontFamilySemiLight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                </Grid>

                <!--
                    Обе колонки прижаты к верху, а не отцентрованы. Иначе
                    строка с однострочным превью центрует текст по высоте
                    плитки, время остаётся наверху — и в списке они пляшут
                    друг относительно друга от чата к чату.
                -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource ListTitleStyle}"
                               Opacity="{Binding TitleOpacity}" />
                    <TextBlock Text="{Binding Preview}"
                               Style="{StaticResource ListSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,6,0,0" VerticalAlignment="Top">
                    <!-- Галочки своего последнего сообщения — перед временем. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Ticks}"
                                   Visibility="{Binding TicksVisibility}"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="14"
                                   CharacterSpacing="-400"
                                   Foreground="{ThemeResource PhoneAccentBrush}"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Time}"
                                   FontSize="14"
                                   Opacity="0.55" />
                    </StackPanel>
                    <!-- Счётчик — квадрат цветом системы, без скруглений. -->
                    <Border Background="{ThemeResource PhoneAccentBrush}"
                            MinWidth="26"
                            Padding="5,0,5,1"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            Visibility="{Binding UnreadVisibility}">
                        <TextBlock Text="{Binding Unread}"
                                   Foreground="White"
                                   FontSize="15"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ContactRowTemplate">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="72" Height="72" Margin="0,0,14,0">
                    <Border Background="{Binding AvatarBrush}"
                            Visibility="{Binding InitialsVisibility}">
                        <TextBlock Text="{Binding Initials}"
                                   Foreground="White"
                                   FontSize="30"
                                   FontFamily="{ThemeResource PhoneFontFamilySemiLight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ListTitleStyle}" />
                    <TextBlock Text="{Binding Preview}" Style="{StaticResource ListSubtitleStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!--
            Pivot, а не список с вкладками сверху: на Windows Phone разделы
            приложения листаются вбок, и это не оформление, а способ
            навигации. Вкладки собираются на месте: «все», «новые», папки
            аккаунта и «контакты».
        -->
        <Pivot x:Name="Sections" Title="ЛОВИТ" />

        <TextBlock x:Name="EmptyText"
                   Text=""
                   Opacity="0.6"
                   Margin="24,120,24,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="SearchButton"
                          Icon="Find"
                          Label="поиск"
                          Click="OnSearch" />
            <AppBarButton x:Name="RefreshButton"
                          Icon="Refresh"
                          Label="обновить"
                          Click="OnRefresh" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="настройки" Click="OnSettings" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
