<Page
    x:Class="Lovit.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="19,24,19,12">
            <TextBlock Text="ЛОВИТ" Style="{StaticResource AppTitleStyle}" Margin="0" />
            <TextBlock x:Name="StepTitle"
                       Text="вход"
                       Style="{StaticResource PageTitleStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="19,0,19,0">
            <StackPanel>
                <TextBlock x:Name="HintText"
                           Text="Номер телефона, на который придёт код"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Margin="0,0,0,16" />

                <TextBox x:Name="PhoneBox"
                         InputScope="TelephoneNumber"
                         PlaceholderText="+7 900 000 00 00" />

                <TextBox x:Name="CodeBox"
                         InputScope="Number"
                         PlaceholderText="Код из SMS"
                         Visibility="Collapsed" />

                <PasswordBox x:Name="PasswordBox"
                             PlaceholderText="Пароль"
                             Visibility="Collapsed" />

                <!-- Создание профиля: номер серверу незнаком. -->
                <TextBox x:Name="FirstNameBox"
                         PlaceholderText="Имя"
                         Visibility="Collapsed" />

                <TextBox x:Name="LastNameBox"
                         PlaceholderText="Фамилия (не обязательно)"
                         Visibility="Collapsed" />

                <Button x:Name="ContinueButton"
                        Content="получить код"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Click="OnContinue" />

                <Button x:Name="ResendButton"
                        Content="отправить код повторно"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        Margin="0,8,0,0"
                        Click="OnResend" />

                <ProgressBar x:Name="Progress"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Margin="0,12,0,0" />

                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Margin="0,12,0,19" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
