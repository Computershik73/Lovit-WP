<Application
    x:Class="Lovit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lovit">

    <Application.Resources>
        <!--
            Оформление намеренно не своё. На Windows Phone у системы есть
            и тема, и цвет выделения, выбранные пользователем; приложение,
            которое рисует своё поверх, выглядит чужим на этом телефоне.
            Поэтому всё держится на PhoneAccentBrush и остальных системных
            кистях — они сами меняются вслед за настройками.

            Размеры взяты из самой системы: 24 и 16 — это ровно те кегли,
            которыми набраны списки в «Сообщениях» и «Людях» тех лет.
        -->

        <Style x:Key="ListTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontFamily" Value="{ThemeResource PhoneFontFamilySemiLight}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="LineHeight" Value="28" />
        </Style>

        <!--
            Превью в две строки, а не в одну.

            Обрезка при этом приходится на последнюю строку, а не на каждую:
            с NoWrap многоточие получал каждый перенос внутри сообщения, и
            строка списка выглядела рванью из обрубков.
        -->
        <Style x:Key="ListSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextTrimming" Value="WordEllipsis" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,-2,0,0" />
        </Style>

        <!--
            Название приложения над заголовком страницы — обязательная часть
            разметки той поры: маленькие прописные буквы с разрядкой, и уже
            под ними крупный заголовок тонким начертанием.
        -->
        <Style x:Key="AppTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Margin" Value="19,12,0,0" />
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="42" />
            <Setter Property="FontFamily" Value="{ThemeResource PhoneFontFamilySemiLight}" />
            <Setter Property="LineHeight" Value="48" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Подпись раздела внутри страницы: строчными, приглушённо. -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Application.Resources>
</Application>
