  <!--
    Последнее число версии растёт само на каждой сборке.

    Иначе пакет с прежним номером Windows считает тем же самым и ставить
    отказывается — «уже установлено», хотя внутри всё другое. Приходилось бы
    каждый раз удалять прежний.

    Шаг делается до проверки манифеста: номер должен смениться раньше, чем
    его прочитает упаковщик. Обычная сборка без упаковки номер не трогает.
  -->
  <Target Name="BumpDesktopRevision" BeforeTargets="_ValidatePresenceOfAppxManifestItems">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest"
             Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" ItemName="_DesktopVersion" />
    </XmlPeek>

    <PropertyGroup>
      <_Version>@(_DesktopVersion)</_Version>
      <_NextRevision>$([MSBuild]::Add($([System.Version]::Parse($(_Version)).Revision), 1))</_NextRevision>
      <_NextVersion>$([System.Version]::Parse($(_Version)).Major).$([System.Version]::Parse($(_Version)).Minor).$([System.Version]::Parse($(_Version)).Build).$(_NextRevision)</_NextVersion>
    </PropertyGroup>

    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest"
             Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version"
             Value="$(_NextVersion)" />

    <Message Importance="high" Text="Версия настольного пакета: $(_Version) -> $(_NextVersion)" />
  </Target>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
