<Application
    x:Class="Lovit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lovit">

    <Application.Resources>
        <!--
            Настольная разметка отличается от телефонной ровно одним: набором
            системных кистей.

            Всё оформление приложения держится на кистях Windows Phone —
            PhoneAccentBrush и остальных, — которых на настольной Windows нет
            вовсе. Их и заводим здесь, поверх здешних системных: цвет
            выделения, цвет текста, цвет плашек и фон. Пользователь меняет их
            в настройках Windows, и приложение меняется вместе с ними — ровно
            так же, как на телефоне.

            Ниже — те же самые начертания, что и в телефонном App.xaml. Они
            повторены, а не подключены ссылкой, потому что этот файл целиком
            свой: подключить чужой App.xaml нельзя — он привязан к своему
            приложению.
        -->

        <SolidColorBrush x:Key="PhoneAccentBrush" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="PhoneForegroundBrush"
                         Color="{ThemeResource SystemBaseHighColor}" />
        <SolidColorBrush x:Key="PhoneBackgroundBrush"
                         Color="{ThemeResource SystemAltHighColor}" />
        <SolidColorBrush x:Key="PhoneChromeBrush"
                         Color="{ThemeResource SystemChromeMediumLowColor}" />

        <!--
            Тонкое начертание. На телефоне это была Segoe WP Light; на
            настольной Windows её нет, и ближайшее по рисунку — Segoe UI
            Light: тот же гротеск того же семейства.
        -->
        <FontFamily x:Key="PhoneFontFamilySemiLight">Segoe UI Light</FontFamily>

        <Style x:Key="ListTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontFamily" Value="{ThemeResource PhoneFontFamilySemiLight}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="LineHeight" Value="28" />
        </Style>

        <Style x:Key="ListSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextTrimming" Value="WordEllipsis" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,-2,0,0" />
        </Style>

        <Style x:Key="AppTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Margin" Value="19,12,0,0" />
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="42" />
            <Setter Property="FontFamily" Value="{ThemeResource PhoneFontFamilySemiLight}" />
            <Setter Property="LineHeight" Value="48" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Application.Resources>
</Application>
